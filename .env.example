# Runtime profile: development, test, or production
CRISISWEAVE_APP_ENV=development
# Production service processes set this to api or ingestion_worker for least-privilege validation.
CRISISWEAVE_RUNTIME_ROLE=api
CRISISWEAVE_DATA_DIR=./data
CRISISWEAVE_LOG_LEVEL=INFO
CRISISWEAVE_LOG_QUERIES=false
# Production API/worker roles require OTLP/HTTP traces and explicit cost allocation. Keep exporter
# authorization in a secret manager; do not place it in committed environment files.
CRISISWEAVE_TELEMETRY_ENABLED=false
CRISISWEAVE_OTEL_SERVICE_NAME=crisisweave
CRISISWEAVE_OTEL_EXPORTER_OTLP_ENDPOINT=
CRISISWEAVE_OTEL_EXPORTER_HEADERS=
CRISISWEAVE_OTEL_EXPORTER_CA_FILE=
# Production Compose mounts this host CA bundle read-only into API and worker containers.
CRISISWEAVE_OTEL_CA_HOST_PATH=/etc/ssl/certs/ca-certificates.crt
CRISISWEAVE_OTEL_TRACE_SAMPLE_RATIO=0.1
CRISISWEAVE_COST_ACCOUNTING_ENABLED=false
CRISISWEAVE_ROUTER_INPUT_COST_PER_MILLION_USD=0
CRISISWEAVE_ROUTER_OUTPUT_COST_PER_MILLION_USD=0
CRISISWEAVE_ANSWER_INPUT_COST_PER_MILLION_USD=0
CRISISWEAVE_ANSWER_OUTPUT_COST_PER_MILLION_USD=0
CRISISWEAVE_QUERY_COMPUTE_COST_PER_HOUR_USD=0
CRISISWEAVE_INGESTION_COMPUTE_COST_PER_HOUR_USD=0
CRISISWEAVE_SLO_QUERY_P95_SECONDS=10
CRISISWEAVE_SLO_INGESTION_P95_SECONDS=600
CRISISWEAVE_SLO_ERROR_RATE=0.01
CRISISWEAVE_AUDIT_RETENTION_DAYS=30
CRISISWEAVE_MAX_AUDIT_ROWS=100000
CRISISWEAVE_ANALYTICS_TIMEOUT_SECONDS=10
CRISISWEAVE_MAX_ANALYTICS_RESULT_BYTES=524288
CRISISWEAVE_MAX_ANALYTICS_CELL_BYTES=32768

# Persistence. Local development uses DuckDB/files. Production requires PostgreSQL and a
# versioning-enabled S3-compatible bucket; keep the DSN/credentials in a secret manager.
CRISISWEAVE_DATABASE_BACKEND=duckdb
CRISISWEAVE_POSTGRES_DSN=
CRISISWEAVE_POSTGRES_POOL_MIN_SIZE=1
CRISISWEAVE_POSTGRES_POOL_MAX_SIZE=8
CRISISWEAVE_POSTGRES_POOL_TIMEOUT_SECONDS=10
# Production Compose maps these three host-side DSNs to the generic runtime setting above.
CRISISWEAVE_API_POSTGRES_DSN=
CRISISWEAVE_WORKER_POSTGRES_DSN=
CRISISWEAVE_MIGRATION_POSTGRES_DSN=
CRISISWEAVE_POSTGRES_API_ROLE=crisisweave_api
CRISISWEAVE_POSTGRES_WORKER_ROLE=crisisweave_worker
CRISISWEAVE_OBJECT_STORE_BACKEND=local
CRISISWEAVE_S3_BUCKET=
CRISISWEAVE_S3_PREFIX=crisisweave
CRISISWEAVE_S3_ENDPOINT_URL=
CRISISWEAVE_S3_REGION=
CRISISWEAVE_S3_ADDRESSING_STYLE=auto
CRISISWEAVE_S3_SERVER_SIDE_ENCRYPTION=AES256
CRISISWEAVE_S3_KMS_KEY_ID=
CRISISWEAVE_OBJECT_STORE_TIMEOUT_SECONDS=15

# API security. Local development uses an API key. Production requires OIDC for users and can use
# hybrid mode for explicitly role-bound, rotatable service keys. Service syntax is
# tenant@key_id=secret with tenant@key_id=role bindings; never use legacy plain keys in production.
CRISISWEAVE_API_KEYS=local-dev-key
CRISISWEAVE_AUTH_MODE=api_key
CRISISWEAVE_OIDC_ISSUER_URL=
CRISISWEAVE_OIDC_AUDIENCE=
CRISISWEAVE_OIDC_JWKS_URL=
CRISISWEAVE_OIDC_ALGORITHMS=RS256,ES256
CRISISWEAVE_OIDC_TENANT_CLAIM=tenant_id
CRISISWEAVE_OIDC_ROLES_CLAIM=roles
CRISISWEAVE_OIDC_IDENTITY_TYPE_CLAIM=identity_type
CRISISWEAVE_OIDC_JWKS_CACHE_SECONDS=300
CRISISWEAVE_OIDC_JWKS_TIMEOUT_SECONDS=5
CRISISWEAVE_OIDC_JWKS_MAX_BYTES=1048576
CRISISWEAVE_OIDC_ALLOW_PRIVATE_JWKS=false
CRISISWEAVE_OIDC_CLOCK_SKEW_SECONDS=30
CRISISWEAVE_SERVICE_KEY_ROLE_BINDINGS=
CRISISWEAVE_REVOKED_SERVICE_KEY_IDS=
# Production Compose pins the gateway source address and trusts only this address as a /32.
CRISISWEAVE_GATEWAY_IPV4=172.30.77.10
CRISISWEAVE_API_GATEWAY_SUBNET=172.30.77.0/24
CRISISWEAVE_FORWARDED_ALLOW_IPS=172.30.77.10/32
CRISISWEAVE_OVERSIGHT_ENABLED=false
CRISISWEAVE_POSTGRES_RLS_ENABLED=false
CRISISWEAVE_IDENTITY_AUDIT_RETENTION_DAYS=365
CRISISWEAVE_MAX_IDENTITY_AUDIT_ROWS=1000000
CRISISWEAVE_REVIEW_RETENTION_DAYS=365
CRISISWEAVE_HIGH_RISK_TERMS=evacuation,shelter allocation,medical triage,dispatch,resource allocation,fatality,missing persons,dam failure,chemical release,evacuación,evacuação,évacuation,εκκένωση,निकासी,انخلا,إخلاء,evakuasi
CRISISWEAVE_MINIMUM_ANSWER_CONFIDENCE=0.65
CRISISWEAVE_MAX_SOURCE_AGE_DAYS=30
CRISISWEAVE_UNKNOWN_SOURCE_FRESHNESS_REQUIRES_REVIEW=false
CRISISWEAVE_CONTRADICTION_ESCALATION_THRESHOLD=0.35
CRISISWEAVE_CORS_ORIGINS=http://localhost:8501
CRISISWEAVE_TRUSTED_HOSTS=localhost,127.0.0.1
CRISISWEAVE_RATE_LIMIT_REQUESTS=60
CRISISWEAVE_RATE_LIMIT_WINDOW_SECONDS=60
CRISISWEAVE_QUEUE_TIMEOUT_SECONDS=5
# Development may consume jobs in the API process. Production API replicas must set this false
# and run one or more `crisisweave ingestion-worker` services.
CRISISWEAVE_INGESTION_WORKER_ENABLED=true
CRISISWEAVE_INGESTION_LIFECYCLE_RETENTION_DAYS=14
CRISISWEAVE_MAX_QUERY_BODY_BYTES=65536
CRISISWEAVE_QUERY_BODY_TIMEOUT_SECONDS=10
CRISISWEAVE_UPLOAD_BODY_TIMEOUT_SECONDS=120
CRISISWEAVE_BODY_CHUNK_TIMEOUT_SECONDS=15

# LLM: the deployed endpoint/model combination must implement OpenAI-compatible chat completions,
# forced function tool calls for the router, and base64 image_url input for the answer model.
# Compatibility is verified by a startup canary in production; development must probe explicitly.
# "disabled" keeps the deterministic local agent active without sending data externally.
CRISISWEAVE_LLM_PROVIDER=disabled
CRISISWEAVE_LLM_BASE_URL=http://host.docker.internal:11434/v1
CRISISWEAVE_LLM_API_KEY=
# These are example provider IDs only; no model is downloaded or verified by this file.
CRISISWEAVE_LLM_ROUTER_MODEL=qwen2.5:7b
CRISISWEAVE_LLM_ANSWER_MODEL=qwen2.5vl:7b
CRISISWEAVE_ROUTER_TEMPERATURE=0.0
CRISISWEAVE_ANSWER_TEMPERATURE=0.1
CRISISWEAVE_PROVIDER_CANARY_ON_STARTUP=true
CRISISWEAVE_MAX_VISION_IMAGES=4
CRISISWEAVE_MAX_VISION_IMAGE_BYTES=5242880

# Retrieval. "hash" is a zero-download development fallback; use sentence_transformers in prod.
CRISISWEAVE_EMBEDDING_PROVIDER=hash
CRISISWEAVE_TEXT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CRISISWEAVE_VISUAL_EMBEDDING_MODEL=clip-ViT-B-32
CRISISWEAVE_RERANKER_PROVIDER=lexical
CRISISWEAVE_RERANKER_MODEL=BAAI/bge-reranker-base
CRISISWEAVE_QDRANT_URL=
CRISISWEAVE_QDRANT_API_KEY=
# Production Compose requires distinct Qdrant identities for each trust role.
CRISISWEAVE_API_QDRANT_API_KEY=
CRISISWEAVE_WORKER_QDRANT_API_KEY=
CRISISWEAVE_MIGRATION_QDRANT_API_KEY=
CRISISWEAVE_API_S3_ACCESS_KEY_ID=
CRISISWEAVE_API_S3_SECRET_ACCESS_KEY=
CRISISWEAVE_WORKER_S3_ACCESS_KEY_ID=
CRISISWEAVE_WORKER_S3_SECRET_ACCESS_KEY=
CRISISWEAVE_EGRESS_POLICY_SHA256=

# Optional live search. Tavily results are snippets only; arbitrary URL fetching is disabled.
CRISISWEAVE_WEB_SEARCH_PROVIDER=disabled
CRISISWEAVE_TAVILY_API_KEY=
CRISISWEAVE_TAVILY_ENDPOINT=https://api.tavily.com/search
CRISISWEAVE_WEB_ALLOWED_DOMAINS=nasa.gov,noaa.gov,usgs.gov,fema.gov
CRISISWEAVE_MAX_WEB_RESPONSE_BYTES=1048576

# Ingestion limits and optional local executables.
CRISISWEAVE_MAX_UPLOAD_BYTES=52428800
CRISISWEAVE_MAX_MULTIPART_OVERHEAD_BYTES=1048576
CRISISWEAVE_MAX_PDF_PAGES=250
CRISISWEAVE_MAX_IMAGE_PIXELS=40000000
CRISISWEAVE_MAX_VIDEO_SECONDS=1800
CRISISWEAVE_MAX_VIDEO_FRAMES=120
CRISISWEAVE_MAX_STRUCTURED_ROWS=50000
CRISISWEAVE_MAX_STRUCTURED_ROWS_PER_TENANT=250000
CRISISWEAVE_MAX_STRUCTURED_CELL_CHARS=8192
CRISISWEAVE_VIDEO_FRAME_INTERVAL_SECONDS=15
CRISISWEAVE_MAX_DOCUMENTS_PER_TENANT=1000
CRISISWEAVE_MAX_STORAGE_BYTES_PER_TENANT=21474836480
CRISISWEAVE_MAX_DERIVED_BYTES_PER_DOCUMENT=524288000
CRISISWEAVE_MIN_FREE_DISK_BYTES=268435456
CRISISWEAVE_MAX_FAILED_DOCUMENTS_PER_TENANT=100
CRISISWEAVE_PARSER_SERVICE_URL=
CRISISWEAVE_PARSER_SERVICE_TOKEN=
CRISISWEAVE_WORKER_METRICS_HOST=127.0.0.1
CRISISWEAVE_WORKER_METRICS_PORT=0
CRISISWEAVE_FFMPEG_PATH=ffmpeg
CRISISWEAVE_FFPROBE_PATH=ffprobe
# Windows development automatically uses the current user's Windows OCR language only when this
# executable is unavailable. Parser/production profiles require Tesseract. OCR changes require
# re-ingestion; OCR is separate from CLIP retrieval and the vision answer model.
CRISISWEAVE_TESSERACT_PATH=tesseract
CRISISWEAVE_MALWARE_SCANNER_PATH=
CRISISWEAVE_TRANSCRIPTION_PROVIDER=disabled
CRISISWEAVE_WHISPER_MODEL=small
