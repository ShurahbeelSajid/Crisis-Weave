{
  "schema_version": 1,
  "benchmark_id": "crisisweave-cyclone-earthquake",
  "version": "1.0.0-source-registry",
  "release_status": "source_registry",
  "description": "Event-disjoint two-hazard benchmark registry covering real tropical cyclones and earthquakes. This v1 scope favors consistent authoritative NOAA/USGS products over superficial hazard breadth. It records public-source pointers but does not claim that linked bytes have been frozen or that gold labels have been adjudicated.",
  "source_url_audit": {
    "checked_at": "2026-08-03",
    "method": "Read-only HTTPS HEAD request with redirects enabled",
    "result": "26 of 26 event/catalog/documentation URLs returned HTTP 200 on the declared NOAA or USGS host.",
    "limitations": "This confirms address availability only; it is not a content-hash, license, completeness, or future-availability guarantee."
  },
  "split_policy": {
    "unit": "canonical_event",
    "train": "Model/index development and prompt iteration only.",
    "development": "Threshold selection and error analysis only.",
    "test": "Sealed final comparison; no prompt, model, or index selection.",
    "prohibited": [
      "random chunk splitting",
      "placing one event's report, imagery, or derived chunks in multiple splits",
      "using test questions or labels for prompt or threshold selection"
    ]
  },
  "split_counts": {
    "development": 6,
    "test": 6,
    "train": 12
  },
  "required_systems": [
    {
      "system_id": "agentic_multimodal_rag",
      "description": "Candidate system with text and visual retrieval, reranking, and agentic vector/SQL/web routing enabled."
    },
    {
      "system_id": "text_only_rag",
      "description": "Conventional fixed vector RAG over textual/OCR evidence only; no visual embeddings, pixel inputs, SQL, web, or agentic routing."
    },
    {
      "system_id": "vector_only_rag",
      "description": "Always use multimodal vector retrieval and reranking; disable SQL, web, and agentic routing."
    },
    {
      "system_id": "no_reranking",
      "description": "Candidate configuration with the reranker bypassed and first-stage order retained."
    },
    {
      "system_id": "no_visual_retrieval",
      "description": "Keep agentic routing but remove image, video-frame, and rendered-PDF visual retrieval."
    },
    {
      "system_id": "no_agentic_routing",
      "description": "Use a fixed route policy selected before evaluation; no model-selected tools."
    }
  ],
  "acquisition_policy": {
    "raw_assets_committed": false,
    "network_fetch_is_opt_in": true,
    "freeze_requirement": "A frozen release must record SHA-256, final URL, byte size, retrieval time, content type, and extractor versions for every materialized asset.",
    "license_requirement": "Review each asset and embedded third-party credit before redistribution. Link-only is the default until that review is complete.",
    "annotation_requirement": "Gold cases require two independent annotators plus adjudication; source metadata alone is never a relevance or groundedness label."
  },
  "shared_structured_sources": [
    {
      "source_id": "nhc-hurdat2-atlantic-2025",
      "publisher": "NOAA National Hurricane Center",
      "url": "https://www.nhc.noaa.gov/data/hurdat/hurdat2-1851-2025-02272026.txt",
      "format_documentation": "https://www.nhc.noaa.gov/data/hurdat/hurdat2-format-atl-1851-2021.pdf",
      "selector": "Filter the catalog by each event's NOAA NHC official_identifier before ingestion.",
      "ingestion_rule": "Never ingest the shared catalog into an event split. Materialize one event-scoped CSV per cyclone and lock both source and derivative hashes."
    }
  ],
